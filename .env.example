# Copy to .env (same folder) and fill in. Never commit .env.

# Gemini API key for the live train agent (F). Empty -> fixtures only.
GEMINI_API_KEY=

# Gemini model for the backup reader of a Koleo page (used only when the code parser finds no trips).
# Model ids available to your key: GET https://generativelanguage.googleapis.com/v1beta/models
# Several ids separated by commas are tried in order (free models are often overloaded or retired).
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash

# Live Koleo provider tuning (defaults in backend/app/providers/koleo_agent.py).
# KOLEO_CACHE_TTL_SEC=900
# KOLEO_TIMEOUT_SEC=100

# fixture: recorded data only, works offline (default).
# koleo: live search via F's provider; any failure falls back to fixtures with a reason.
TRAIN_PROVIDER=fixture

# Telegram notifications. Empty -> the UI shows the message itself.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frozen "now" for the demo, with time zone. Departed options are hidden relative to "now",
# so on pitch day (after the event's trains left) set e.g. the morning of the event:
# DEMO_NOW=2026-10-04T03:00:00+02:00
# Empty -> real current time.
DEMO_NOW=

# Optional backend settings (defaults in backend/app/config.py).
# MC_RUNS=1000
# SSE_STEP_SEC=0.4
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
