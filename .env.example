# Copy to .env (same folder) and fill in. Never commit .env.

# Gemini API key for the live train agent (F). Empty -> fixtures only.
GEMINI_API_KEY=

# Telegram notifications (F). Empty -> the UI shows the message itself.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional backend settings (defaults in backend/app/config.py).
# MC_RUNS=1000
# SSE_STEP_SEC=0.4
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
